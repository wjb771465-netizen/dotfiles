#!/bin/zsh
# Hybrid Zotero MCP: local reads + Web API writes. Key from pass/keychain.
set -euo pipefail
source "${HOME}/.config/shell/keys.sh"
export PATH="${HOME}/.local/bin:${PATH}"
export ZOTERO_LOCAL=true
export ZOTERO_LIBRARY_ID=20407828
export ZOTERO_LIBRARY_TYPE=user
export ZOTERO_API_KEY="$(key zotero)"
# FastMCP banner hits PyPI via httpx; under SOCKS proxy that ImportErrors
# without socksio and kills stdio before tools register. Skip the check.
export FASTMCP_CHECK_FOR_UPDATES=off
# Cursor often injects SOCKS proxies; httpx needs socksio for those, and
# Web API writes would crash the same way. Drop proxy env so Local + Web
# API use direct/localhost (Zotero API is reachable without the app proxy).
unset ALL_PROXY all_proxy SOCKS_PROXY socks_proxy HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
if [[ -z "${ZOTERO_API_KEY}" ]]; then
  echo "zotero-mcp-hybrid: empty ZOTERO_API_KEY (pass/keychain zotero key empty?)" >&2
  exit 1
fi
exec zotero-mcp "$@"
