{
    "window.autoDetectColorScheme": true,
    "workbench.preferredLightColorTheme": "Visual Studio Dark",
    "remote.SSH.remotePlatform": {
        "server": "linux"
    },
    "explorer.confirmDelete": false,
    "diffEditor.hideUnchangedRegions.enabled": true,
    "files.associations": {
        "**/.claude/**/*.md": "markdown"
    },
    "workbench.colorCustomizations": {
        "editor.selectionBackground": "#6e0ce6",
        "editor.findMatchBackground": "#c73535",
        "editor.findMatchForeground": "#d8f213",
        "tab.activeBackground": "#586e9d"
    },
    "remote.autoForwardPortsSource": "hybrid",
    "cursor.general.disableHttp2": true,
    "http.proxySupport": "override",
    "http.proxy": "http://127.0.0.1:7892",
    "http.proxyStrictSSL": false,
    "git.openRepositoryInParentFolders": "never"
}
